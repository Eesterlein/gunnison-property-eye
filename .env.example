# Database
POSTGRES_DB=property_eye
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yourpassword
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5433/property_eye

# Google Earth Engine
# Service account email from GEE project
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
# Path to service account JSON key file (never commit this file)
GEE_KEY_FILE=./secrets/gee-key.json

# Auth
JWT_SECRET=your-random-secret-here

# Scan completion notifications (Phase 6 scheduler)
# Optional — if SMTP_HOST or SCAN_NOTIFICATION_EMAILS is unset, the scheduler
# just logs the scan summary instead of emailing it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender address (services like Brevo use a login that isn't a mailbox)
SMTP_FROM=
SCAN_NOTIFICATION_EMAILS=staff@example.org

# App
ENVIRONMENT=development
# Link included in scan emails
APP_URL=http://localhost:5173
# Public read-only demo (no login, writes refused); frontend also needs VITE_DEMO_MODE=true
DEMO_MODE=false

# Frontend (Vite)
# tipg has CORS enabled so the frontend hits it directly
VITE_TIPG_URL=http://localhost:8002/api
# ENVIRONMENT=production

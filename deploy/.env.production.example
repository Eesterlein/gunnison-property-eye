# Copy to deploy/.env.production (never committed) and fill in.
# deploy.sh generates POSTGRES_PASSWORD and JWT_SECRET for you if left blank.

# Public address. With no domain yet, use <server-ip>.sslip.io — Caddy gets a
# real HTTPS certificate for it automatically.
SITE_ADDRESS=203.0.113.10.sslip.io
APP_URL=https://203.0.113.10.sslip.io
FRONTEND_URL=https://203.0.113.10.sslip.io

# Public read-only demo: no login, no owner names, writes refused
DEMO_MODE=true

POSTGRES_DB=property_eye
POSTGRES_USER=property_eye
POSTGRES_PASSWORD=
JWT_SECRET=

# Google Earth Engine (key file is copied to secrets/gee-key.json on the server)
GEE_SERVICE_ACCOUNT=your-service-account@your-project.iam.gserviceaccount.com
GEE_PROJECT=your-gee-project

# Scan summary emails — Brevo (free tier): Settings → SMTP & API → SMTP
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASSWORD=your-brevo-smtp-key
# Must be a sender address verified in Brevo
SMTP_FROM=you@example.com
SCAN_NOTIFICATION_EMAILS=you@example.com

ENVIRONMENT=production
